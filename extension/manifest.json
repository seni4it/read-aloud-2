{
  "manifest_version": 3,
  "name": "Read Aloud 2",
  "version": "2.5.1",
  "description": "Listen to web pages and PDFs with natural voices that run on your Mac. Word highlighting, speed up to 4x, play from any paragraph.",
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Read Aloud 2"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "offscreen",
    "tts",
    "webRequest",
    "alarms"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "play-pause": {
      "description": "Play or pause"
    },
    "back": {
      "description": "Previous sentence"
    },
    "forward": {
      "description": "Next sentence"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
