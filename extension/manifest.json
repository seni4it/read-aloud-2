{
  "manifest_version": 3,
  "name": "Read Aloud 2",
  "version": "2.0.0",
  "description": "Listen to any web page with natural voices that run on your Mac. Word highlighting, speed up to 4x, play from any paragraph.",
  "icons": { "16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png" },
  "action": { "default_popup": "popup.html", "default_title": "Read Aloud 2" },
  "background": { "service_worker": "background.js" },
  "permissions": ["storage", "contextMenus", "offscreen", "tts"],
  "host_permissions": ["http://127.0.0.1:8793/*", "http://localhost:8793/*"],
  "content_scripts": [{ "matches": ["<all_urls>"], "js": ["content.js"], "css": ["content.css"], "run_at": "document_idle" }],
  "commands": {
    "play-pause": { "description": "Play or pause" },
    "back": { "description": "Previous sentence" },
    "forward": { "description": "Next sentence" }
  }
}
